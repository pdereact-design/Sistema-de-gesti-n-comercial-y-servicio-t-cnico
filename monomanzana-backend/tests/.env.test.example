# Configuración necesaria en .env para ejecutar las pruebas funcionales.
# Las pruebas usan la misma conexión de producción pero sobre monomanzana_test.
# No se requiere un archivo .env separado; se leen las variables del .env del proyecto.

# Requerido: usuario con permiso CREATEDB para crear/eliminar monomanzana_test
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=tu_password_de_postgres

# Las siguientes variables ya deben existir en .env y se usan tal cual:
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, JWT_SECRET

# El script nunca imprime los valores de estas variables en la terminal.
