# Servidor
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monomanzana_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Usuario con permiso CREATEDB (para db:setup y pruebas automatizadas)
# Puede ser el mismo que DB_USER si tiene ese permiso
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=tu_password_admin_aqui

# JWT — genera un valor aleatorio seguro (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_largo_y_seguro
JWT_EXPIRES_IN=8h

# Contraseña del administrador inicial (solo para db:seed, mínimo 8 caracteres)
ADMIN_PASSWORD=cambia_esto_antes_de_ejecutar_db_seed
